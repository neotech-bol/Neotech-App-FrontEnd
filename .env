


# API Base URL
# VUE_APP_API_BASE_U  RL=https://api.tudominio.com/api

# Configuración de autenticación
VUE_APP_AUTH_TOKEN_KEY=auth_token
VUE_APP_REFRESH_TOKEN_KEY=refresh_token

# Configuración de imágenes
VUE_APP_IMAGE_BASE_URL=https://cdn.tudominio.com
VUE_APP_DEFAULT_IMAGE=/placeholder.jpg

# Configuración de moneda
VUE_APP_CURRENCY=BOB
VUE_APP_CURRENCY_LOCALE=es-BO

# Configuración de paginación
VUE_APP_DEFAULT_PAGE_SIZE=12

# Configuración de características
VUE_APP_ENABLE_FAVORITES=true
VUE_APP_ENABLE_CART=true

# Configuración de notificaciones
VUE_APP_NOTIFICATION_TIMEOUT=3000

# Variables de entorno específicas para desarrollo
NODE_ENV=development